# Netlify reads this file automatically. It adds safe security headers and does not change how pages look.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Speed: images are cached on the visitor's device for 7 days (604800 seconds). If you ever replace a photo,
# give the new file a NEW name (or wait up to a week), otherwise returning visitors can still see the old one.
/assets/*
  Cache-Control: public, max-age=604800
