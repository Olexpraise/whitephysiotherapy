# Netlify reads this file automatically. It adds safe security headers and does not change how pages look.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# LAUNCH TIP (speed): once the final photos are in, remove the "#" in front of the next 2 lines so
# returning visitors load images from their own device. Do this only after the photos are final,
# because a replaced photo with the same name can show the old one for a week.
# /assets/*
#   Cache-Control: public, max-age=604800
